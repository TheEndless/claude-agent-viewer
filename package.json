{
  "name": "agent-viewer",
  "displayName": "Agent Viewer",
  "description": "View running and past Claude Code agents on this machine",
  "version": "0.0.2",
  "publisher": "agent-viewer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dipeshnx/agent-viewer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-viewer",
          "title": "Agents",
          "icon": "resources/agent.svg"
        }
      ]
    },
    "views": {
      "agent-viewer": [
        {
          "id": "agentViewer.panel",
          "name": "Agents",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentViewer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentViewer.refresh",
          "when": "view == agentViewer.panel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run src/test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "chokidar": "^3.6.0",
    "markdown-it": "^14.1.1"
  }
}
